# vllm-backport ARM64 App 层 — 只替换 Python/Triton 代码,不重编 CUDA 扩展
#
# 为什么要分层:本 fork 的 sm80 适配绝大部分是 Python + Triton
# (vllm/v1/attention/ops/fp8_sm80.py、mqa_logits_triton.py、
#  vllm/models/deepseek_v4/ampere/ 等),改这些不需要动 nvcc。
# 全量编译(docker/build_base_aarch64.sh)是小时级,app 层是分钟级。
#
# ⚠ 什么时候必须重建 base 而不是只跑 app 层:
#   csrc/ | CMakeLists.txt | cmake/ | setup.py | requirements/ 有改动时。
#   本 fork 确实改了 csrc(custom_all_reduce.cuh / libtorch_stable/*),
#   所以不能用 VLLM_USE_PRECOMPILED,base 必须自己编。
#   build-arm64-app.yml 里的 "Guard" 步骤会在这些路径变化时直接失败。
#
# 用法:
#   docker build -f docker/Dockerfile.aarch64_app \
#     --build-arg BASE_IMAGE=arronlee/vllm-backport:arm64-sm80-base \
#     -t vllm-backport:app .

ARG BASE_IMAGE=arronlee/vllm-backport:arm64-sm80-base
FROM ${BASE_IMAGE}

# base 里 vllm 是 `uv pip install --system dist/*.whl` 装的(不在 /opt/venv),
# 具体 site-packages 路径随 PYTHON_VERSION / deadsnakes 布局变化,
# 所以构建时解析,不写死。
COPY vllm/ /tmp/vllm-src/

RUN set -eux; \
    # 宿主机若在仓库里 in-place 编译过,vllm/ 下会残留 .so;
    # 那些是给宿主 arch 编的,绝不能覆盖 base 里正确的产物。
    find /tmp/vllm-src -name '*.so' -delete; \
    find /tmp/vllm-src -name '__pycache__' -type d -prune -exec rm -rf {} +; \
    VLLM_PKG="$(python3 -c 'import vllm, os; print(os.path.dirname(vllm.__file__))')"; \
    echo "overlaying python tree onto ${VLLM_PKG}"; \
    # 编译产物(_C.abi3.so 等)和 setuptools_scm 生成的 _version.py 都在
    # ${VLLM_PKG} 里且不在 git 中。用 merge 语义的 `cp -a src/. dest/`,
    # 不要先删目标目录。
    find "${VLLM_PKG}" -name '__pycache__' -type d -prune -exec rm -rf {} +; \
    cp -a /tmp/vllm-src/. "${VLLM_PKG}/"; \
    rm -rf /tmp/vllm-src; \
    # 冒烟:import 成功 + 确认编译产物里仍含 sm_80。
    python3 -c "import vllm; print('vllm', vllm.__version__)"; \
    python3 -c "import torch; al = torch.cuda.get_arch_list(); print('arch_list', al); assert any('80' in a for a in al), 'sm_80 missing in base image'"

# 这两个在 base 里是 COPY 进来的,同步更新以免和 Python 树版本漂移。
COPY examples examples
COPY benchmarks benchmarks

# ray:跨节点 TP/PP 必需。
#
# vLLM 的 distributed_executor_backend 只有 mp(单机)和 ray(跨机),
# 多节点必须有 ray,而且 ray worker 是在容器内起的,必须和容器里的
# vllm/torch 共用同一个 Python 环境 —— 装在宿主系统里容器看不见。
# 版本按 requirements/test/cuda.txt 的 pin。
#
# 烘进镜像而不是每次起集群时 pip install:实测 8 个容器并发装会互相拖慢
# 到 15 分钟以上,而这一层只需在构建时付一次。
RUN pip install --no-cache-dir "ray[cgraph,default]==2.56.1" \
 && ray --version

# Mooncake:跨实例 KV 共享的传输层。
#
# 为什么需要:本集群的 KV 分层受传输带宽支配(见
# docs/deployment/a100-token-capacity-analysis.md §7.4)。实测重算 140k 上下文
# 需 12.3s,而搬同一份 KV(约 75 KB/token,平均会话 12.5 GB)需要:
#   宿主内存 PCIe ~20 GB/s -> 0.6s      ✅ 已用(--kv-offloading-size)
#   RoCE RDMA 4x100G 50 GB/s -> 0.25s   ✅ 本层要打开的通道
#   NFS 多流聚合 0.95 GB/s   -> 13.2s   ❌ 不如重算
#   本地盘 0.11 GB/s         -> 115s    ❌
# 也就是说跨实例共享只有走 RDMA 才成立,而那 4 张 100G 卡目前只用来传
# PP 的 hidden states(每步几十 MB),带宽几乎全空着。
#
# 装在镜像里而不是宿主机:连接器是在 vllm worker 进程内 import 的
# (mooncake_connector.py:71 `from mooncake.engine import TransferEngine`),
# 必须和容器里的 vllm/torch 同一个 Python 环境。
#
# 只装 mooncake,不装 nixl:
#   mooncake-transfer-engine -> MooncakeStoreConnector(共享 KV 池,我们要的)
#   nixl                     -> NixlConnector,是 P2P/PD 分离用的,不是共享缓存;
#       且它 `Requires-Dist: torch`,pip 会重新解析 torch 并去拉
#       nvidia-nccl-cu13(206 MB)等,有覆盖 base 里 2.13.0+cu130(带 sm_80)
#       的风险 —— 实测触发过一次,及时中止。等真要做 PD 分离再单独评估,
#       届时务必 --no-deps。
#
# `--no-deps` 的依据(新增依赖时必须重新核实这一行):mooncake 的
# Requires-Dist 只有 aiohttp / requests / msgpack,base 里分别是
# 3.14.3 / 2.34.2 / 1.2.2,均已满足。跳过依赖解析既安全,又避免 pip
# 顺手动到 torch。
#
# 只装包不足以启用:MooncakeStoreConnector 运行时还需要 metadata_server
# (etcd/http/redis)与 master_server_address 两个常驻服务,那是部署侧的事。
#
# 不 pin 小版本:该包迭代快,且 aarch64 轮子只在较新版本齐全
# (实测 cp312 manylinux_2_28_aarch64 自 0.3.8 起可用,当前 0.3.13.post1)。
# 还要补一份 CUDA 12 运行时:mooncake 的预编译轮子链接 libcudart.so.12
# (`ldd .../mooncake/engine.so` -> `libcudart.so.12 => not found`),
# 而 base 是 CUDA 13(只有 libcudart.so.13),PyPI 也没有 cu13 变体。
#
# 两个运行时同进程共存是安全的:soname 不同(.so.12 / .so.13),torch 按
# soname 解析仍拿到 13,mooncake 拿 12,驱动对 12 向后兼容。已在 A100 节点
# 实测:torch 建 GPU 张量 -> import mooncake -> torch 再建张量,全部正常,
# arch_list 仍含 sm_80。
#
# 用 ld.so.conf.d 而不是 ENV LD_LIBRARY_PATH:后者会被所有子进程继承并影响
# 整个镜像的库搜索顺序,且 base 若未设该变量会留下空条目(等于当前目录)。
RUN pip install --no-cache-dir --no-deps mooncake-transfer-engine nvidia-cuda-runtime-cu12 \
 && CU12_LIB="$(python3 -c 'import nvidia.cuda_runtime as m, os; print(os.path.join(list(m.__path__)[0], "lib"))')" \
 && test -e "${CU12_LIB}/libcudart.so.12" \
 && echo "${CU12_LIB}" > /etc/ld.so.conf.d/zz-cuda12-for-mooncake.conf \
 && ldconfig \
 && python3 -c "from mooncake.engine import TransferEngine; print('mooncake TransferEngine OK')" \
 && python3 -c "from mooncake.store import MooncakeDistributedStore; print('mooncake Store OK')" \
 && python3 -c "import torch; al=torch.cuda.get_arch_list(); print('arch_list', al); assert any('80' in a for a in al), 'sm_80 lost'"

# base 的 ENTRYPOINT 是 ["vllm", "serve"],保持不变。
